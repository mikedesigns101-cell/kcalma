<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_anillo"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:contentDescription="Calorías que te quedan hoy" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Te quedan hoy"
            android:textColor="@color/widget_texto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_macros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_texto2"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_foto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_boton_foto"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="📷 Foto"
                android:textColor="@color/widget_sobre_acento"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_anadir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_boton"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="＋ Añadir"
                android:textColor="@color/widget_texto"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
